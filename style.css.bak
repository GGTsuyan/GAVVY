:root {
  --primary-color: #ff6b9d;
  --secondary-color: #9d65c9;
  --accent-color: #5d54a4;
  --text-color: #333;
  --light-color: #fff;
  --background-color: #f9f3f8;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background-color: var(--background-color);
  color: var(--text-color);
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

#app {
  width: 100%;
  min-height: 100vh;
  position: relative;
}

.page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 100vh;
  display: none;
  justify-content: center;
  align-items: center;
  padding: 2rem;
  transition: opacity 0.5s ease-in-out;
  background-color: var(--background-color);
  background-image: url('https://www.transparenttextures.com/patterns/cubes.png');
}

.page.active {
  display: flex;
  animation: fadeIn 1s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.container {
  max-width: 800px;
  width: 100%;
  background-color: var(--light-color);
  border-radius: 20px;
  padding: 2rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  text-align: center;
}

.title {
  font-family: 'Dancing Script', cursive;
  font-size: 3rem;
  color: var(--primary-color);
  margin-bottom: 1.5rem;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 1.5rem;
  margin-bottom: 2rem;
  color: var(--accent-color);
}

.message {
  font-size: 1.2rem;
  margin: 1.5rem 0;
  line-height: 1.8;
}

.btn {
  background-color: var(--primary-color);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 50px;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  margin-top: 1.5rem;
}

.btn:hover {
  background-color: var(--secondary-color);
  transform: translateY(-3px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
}

